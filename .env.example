APP_NAME="Gadai Berkah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Untuk MySQL, ubah DB_CONNECTION=mysql dan isi di bawah:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gadai_berkah
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=public
